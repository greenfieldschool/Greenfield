# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email through the school's Gmail (see docs/email-setup.md)
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
EMAIL_TOKEN_KEY=
# Any long random string: openssl rand -hex 32
CRON_SECRET=
# Optional
EMAIL_DAILY_LIMIT=450
NEXT_PUBLIC_SITE_URL=https://greenfieldschool.ng

# Phone notifications (Web Push). Make a key pair once with: npx web-push generate-vapid-keys
# The public key can go in either name (NEXT_PUBLIC_ is fine: it isn't secret). Keep the private key secret.
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# An address the push services (Google, Apple) can contact about our alerts
VAPID_SUBJECT=mailto:greenfieldschslekki@gmail.com
